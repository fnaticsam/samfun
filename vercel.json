{
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/ldn-refresh.mjs": {
      "maxDuration": 300
    },
    "api/tracks-playlist.js": {
      "maxDuration": 30
    },
    "api/tracks-ocr.js": {
      "maxDuration": 60
    },
    "api/londonplan.js": {
      "maxDuration": 10
    },
    "api/dev.js": {
      "maxDuration": 10
    },
    "api/dev-ask.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/ldn-refresh",
      "schedule": "0 8 1 * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.knomi.club"
        }
      ],
      "destination": "https://knomi.club/:path*",
      "permanent": true
    },
    {
      "source": "/dev/:path*",
      "has": [
        {
          "type": "host",
          "value": "knomi.club"
        }
      ],
      "destination": "https://knomi.club/",
      "permanent": false
    },
    {
      "source": "/londonplan/:path*",
      "has": [
        {
          "type": "host",
          "value": "knomi.club"
        }
      ],
      "destination": "https://knomi.club/",
      "permanent": false
    },
    {
      "source": "/phone",
      "destination": "https://phone-nine-theta.vercel.app",
      "permanent": false
    },
    {
      "source": "/phone/:path*",
      "destination": "https://phone-nine-theta.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/vroom",
      "destination": "https://vroom.fan/",
      "permanent": true
    },
    {
      "source": "/vroom/:path(.*)",
      "destination": "https://vroom.fan/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "knomi.club"
        }
      ],
      "destination": "/awakening/index.html"
    },
    {
      "source": "/londonplan",
      "destination": "/api/londonplan"
    },
    {
      "source": "/londonplan/",
      "destination": "/api/londonplan"
    },
    {
      "source": "/dev",
      "destination": "/api/dev"
    },
    {
      "source": "/dev/",
      "destination": "/api/dev"
    },
    {
      "source": "/dev/ask",
      "destination": "/api/dev-ask"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
